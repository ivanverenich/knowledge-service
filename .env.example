KNOWLEDGE_SERVICE_ENVIRONMENT=local
KNOWLEDGE_SERVICE_LOG_LEVEL=INFO

# Optional locally; required in production. Never commit a real value.
KNOWLEDGE_SERVICE_MODEL_API_KEY=

# Optional locally; required in production. Keep real credentials out of Git.
KNOWLEDGE_SERVICE_DATABASE_URL=

# The local BGE-M3 server (ml/bge_m3_server); the default is shown.
# LOCAL_EMBEDDING_URL=http://127.0.0.1:8765

# The local reranker server (ml/bge_m3_server/reranker_server.py); the default
# is shown.
# LOCAL_RERANKER_URL=http://127.0.0.1:8767

# The OpenAI model that ranks Candidates for `--llm-rerank`, and its list
# prices in USD per million tokens; the defaults are shown. Set both prices
# when you change the model.
# LLM_RERANK_MODEL=gpt-5.4-mini-2026-03-17
# LLM_RERANK_INPUT_USD_PER_MILLION_TOKENS=0.75
# LLM_RERANK_OUTPUT_USD_PER_MILLION_TOKENS=4.50
